{
    "$defs": {
        "AuthorImportDto": {
            "properties": {
                "name": {
                    "title": "Name",
                    "type": "string"
                },
                "email": {
                    "title": "Email",
                    "type": "string"
                },
                "orcid": {
                    "anyOf": [
                        {},
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Orcid"
                },
                "affiliation": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Affiliation"
                },
                "role": {
                    "$ref": "#/$defs/Role",
                    "default": "Co-author"
                }
            },
            "required": [
                "name",
                "email"
            ],
            "title": "AuthorImportDto",
            "type": "object"
        },
        "ConceptImportDto": {
            "properties": {
                "name": {
                    "default": "",
                    "title": "Name",
                    "type": "string"
                },
                "vocabulary_name": {
                    "default": "",
                    "title": "Vocabulary Name",
                    "type": "string"
                }
            },
            "title": "ConceptImportDto",
            "type": "object"
        },
        "ContractImportDto": {
            "properties": {
                "name": {
                    "title": "Name",
                    "type": "string"
                },
                "year": {
                    "exclusiveMinimum": 0,
                    "title": "Year",
                    "type": "integer"
                }
            },
            "required": [
                "name",
                "year"
            ],
            "title": "ContractImportDto",
            "type": "object"
        },
        "CostEstimateImportDto": {
            "properties": {
                "amount": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "string"
                        }
                    ],
                    "title": "Amount"
                },
                "currency": {
                    "title": "Currency",
                    "type": "string"
                },
                "payment_method": {
                    "$ref": "#/$defs/PaymentMethod"
                }
            },
            "required": [
                "amount",
                "currency",
                "payment_method"
            ],
            "title": "CostEstimateImportDto",
            "type": "object"
        },
        "DecidedFundingImportDto": {
            "properties": {
                "amount": {
                    "anyOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "string"
                        }
                    ],
                    "title": "Amount"
                },
                "currency": {
                    "title": "Currency",
                    "type": "string"
                }
            },
            "required": [
                "amount",
                "currency"
            ],
            "title": "DecidedFundingImportDto",
            "type": "object"
        },
        "FundingRequestImportDto": {
            "properties": {
                "request_date": {
                    "format": "date",
                    "title": "Request Date",
                    "type": "string"
                },
                "legacy_request_id": {
                    "default": "",
                    "title": "Legacy Request Id",
                    "type": "string"
                },
                "review": {
                    "$ref": "#/$defs/ReviewImportDto"
                },
                "publication": {
                    "$ref": "#/$defs/PublicationImportDto"
                },
                "research_funding": {
                    "items": {
                        "$ref": "#/$defs/ResearchFundingImportDto"
                    },
                    "title": "Research Funding",
                    "type": "array"
                },
                "estimated_cost": {
                    "$ref": "#/$defs/CostEstimateImportDto"
                },
                "request_remarks": {
                    "default": "",
                    "title": "Request Remarks",
                    "type": "string"
                },
                "seperate_contact": {
                    "$ref": "#/$defs/SeperateContactImportDto"
                }
            },
            "required": [
                "request_date",
                "publication"
            ],
            "title": "FundingRequestImportDto",
            "type": "object"
        },
        "License": {
            "enum": [
                "CC-BY",
                "CC-BY-SA",
                "CC-BY-NC",
                "CC-BY-NC-SA",
                "CC-BY-NC-ND",
                "CC-BY-ND",
                "CC0",
                "Unknown",
                "Proprietary",
                "None"
            ],
            "title": "License",
            "type": "string"
        },
        "LinkImportDto": {
            "properties": {
                "type": {
                    "title": "Type"
                },
                "value": {
                    "title": "Value",
                    "type": "string"
                }
            },
            "required": [
                "type",
                "value"
            ],
            "title": "LinkImportDto",
            "type": "object"
        },
        "OpenAccessType": {
            "enum": [
                "Gold",
                "Diamond",
                "Hybrid",
                "Opt-in",
                "Opt-out",
                "Unknown",
                "Closed"
            ],
            "title": "OpenAccessType",
            "type": "string"
        },
        "PaymentMethod": {
            "enum": [
                "direct",
                "reimbursement",
                "unknown"
            ],
            "title": "PaymentMethod",
            "type": "string"
        },
        "PublicationImportDto": {
            "properties": {
                "title": {
                    "title": "Title",
                    "type": "string"
                },
                "kind": {
                    "enum": [
                        "article",
                        "monograph"
                    ],
                    "title": "Kind",
                    "type": "string"
                },
                "eissn": {
                    "default": "",
                    "title": "Eissn"
                },
                "journal_name": {
                    "default": "Imported nameless journal",
                    "title": "Journal Name",
                    "type": "string"
                },
                "publisher_name": {
                    "default": "Imported nameless publisher",
                    "title": "Publisher Name",
                    "type": "string"
                },
                "authors": {
                    "items": {
                        "$ref": "#/$defs/AuthorImportDto"
                    },
                    "title": "Authors",
                    "type": "array"
                },
                "license": {
                    "$ref": "#/$defs/License",
                    "default": "Unknown"
                },
                "publishing_state": {
                    "$ref": "#/$defs/PublishingStateImportDto"
                },
                "open_access_type": {
                    "$ref": "#/$defs/OpenAccessType"
                },
                "links": {
                    "items": {
                        "$ref": "#/$defs/LinkImportDto"
                    },
                    "title": "Links",
                    "type": "array"
                },
                "contracts": {
                    "items": {
                        "$ref": "#/$defs/ContractImportDto"
                    },
                    "title": "Contracts",
                    "type": "array"
                },
                "subject_area": {
                    "$ref": "#/$defs/ConceptImportDto"
                },
                "publication_type": {
                    "$ref": "#/$defs/ConceptImportDto"
                }
            },
            "required": [
                "title",
                "kind",
                "open_access_type"
            ],
            "title": "PublicationImportDto",
            "type": "object"
        },
        "PublishingStateImportDto": {
            "properties": {
                "state": {
                    "default": "unknown",
                    "enum": [
                        "unknown",
                        "submitted",
                        "accepted",
                        "rejected",
                        "published"
                    ],
                    "title": "State",
                    "type": "string"
                },
                "online_date": {
                    "anyOf": [
                        {
                            "format": "date",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Online Date"
                },
                "print_date": {
                    "anyOf": [
                        {
                            "format": "date",
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Print Date"
                }
            },
            "title": "PublishingStateImportDto",
            "type": "object"
        },
        "ResearchFundingImportDto": {
            "properties": {
                "funder": {
                    "title": "Funder",
                    "type": "string"
                },
                "project_id": {
                    "title": "Project Id",
                    "type": "string"
                },
                "project_name": {
                    "default": "",
                    "title": "Project Name",
                    "type": "string"
                }
            },
            "required": [
                "funder",
                "project_id"
            ],
            "title": "ResearchFundingImportDto",
            "type": "object"
        },
        "ReviewImportDto": {
            "properties": {
                "result": {
                    "$ref": "#/$defs/ReviewResult",
                    "default": "open"
                },
                "funding": {
                    "$ref": "#/$defs/DecidedFundingImportDto",
                    "default": {
                        "amount": "0.00",
                        "currency": "EUR"
                    }
                },
                "remarks": {
                    "default": "",
                    "title": "Remarks",
                    "type": "string"
                }
            },
            "title": "ReviewImportDto",
            "type": "object"
        },
        "ReviewResult": {
            "enum": [
                "open",
                "waived",
                "approved",
                "rejected",
                "closed"
            ],
            "title": "ReviewResult",
            "type": "string"
        },
        "Role": {
            "enum": [
                "Submitter",
                "Co-author",
                "Corresponding author",
                "Submitting corresponding author"
            ],
            "title": "Role",
            "type": "string"
        },
        "SeperateContactImportDto": {
            "properties": {
                "name": {
                    "title": "Name",
                    "type": "string"
                },
                "email": {
                    "title": "Email",
                    "type": "string"
                }
            },
            "required": [
                "name",
                "email"
            ],
            "title": "SeperateContactImportDto",
            "type": "object"
        }
    },
    "properties": {
        "requests": {
            "items": {
                "$ref": "#/$defs/FundingRequestImportDto"
            },
            "title": "Requests",
            "type": "array"
        }
    },
    "required": [
        "requests"
    ],
    "title": "FundingRequestImportListDto",
    "type": "object"
}
