#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

python /app/manage.py migrate
python /app/manage.py loaddata config/fixtures/*

# NOTE: adding journals also adds contracts, which should be reworked
python manage.py add_test_journals

python /app/manage.py collectstatic --noinput

exec gunicorn config.wsgi --bind 0.0.0.0:8000 --chdir=/app
