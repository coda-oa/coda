# General
# ------------------------------------------------------------------------------
# DJANGO_READ_DOT_ENV_FILE=True
DJANGO_SETTINGS_MODULE=config.settings.production

# Required settings
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=

# Optional settings
# DJANGO_ADMIN_URL=
# DJANGO_USE_X_FORWARDED_HOST=
# DJANGO_FORCE_SCRIPT_NAME=
# DJANGO_CSRF_TRUSTED_ORIGINS=

# Security
# ------------------------------------------------------------------------------
